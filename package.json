{
  "name": "casuya-blackboard",
  "version": "0.1.0",
  "description": "Interactive digital blackboard with stylus input, step-by-step math validation, and handwriting recognition for the Casuya educational platform",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "katex": "^0.17.0",
    "perfect-freehand": "^1.2.3",
    "tesseract.js": "^5.1.0"
  },
  "optionalDependencies": {
    "mathjs": "^13.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "happy-dom": "^20.10.6",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "license": "MIT"
}
